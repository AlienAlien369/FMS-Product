{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE"]
        },
        "Transforms": [{ "PathRemovePrefix": "/api/v1" }]
      },
      "identity-users": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE"]
